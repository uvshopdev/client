#: components/Footer/Footer.tsx:138
msgctxt "footer"
msgid "8XHjsd"
msgstr "Transaction and accrued miles data"

#: components/Footer/Footer.tsx:139
msgctxt "footer"
msgid "iFEl2k"
msgstr "Loyalty program status data"

#: components/Footer/Footer.tsx:140
msgctxt "footer"
msgid "1UarQp"
